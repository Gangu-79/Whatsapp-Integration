# ==========================================
# 1. OFFICIAL META WHATSAPP CLOUD API CONFIGURATION
# ==========================================
# Permanent System User Access Token from Meta Developers Console (starts with EAAG...)
WHATSAPP_TOKEN=your_meta_system_user_access_token_here

# WhatsApp Phone Number ID (from Meta Developers > WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here

# Approved Meta Template Name (required for outbound marketing outside 24h service window)
WHATSAPP_TEMPLATE_NAME=campaign_update
WHATSAPP_TEMPLATE_LANG=en_US

# Verification token for incoming webhook (set matching token in Meta App Webhook settings)
WEBHOOK_VERIFY_TOKEN=whatsapp_campaign_verify_token_123

# ==========================================
# 2. ANTHROPIC CLAUDE CONFIGURATION (OPTIONAL)
# ==========================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-haiku-latest
USE_CLAUDE=false

# ==========================================
# 3. SERVER SETTINGS
# ==========================================
PORT=8085
