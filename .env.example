# ==========================================
# 1. ANTHROPIC CLAUDE CONFIGURATION
# ==========================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-haiku-latest

# Set to 'false' if you want direct variable replacement without calling Claude
USE_CLAUDE=true

# Your WhatsApp number to connect/send from (with country code, e.g. 918919358544)
SENDER_PHONE_NUMBER=919876543210

EVOLUTION_API_URL=http://localhost:8085
EVOLUTION_API_KEY=my_secret_api_key_12345
EVOLUTION_INSTANCE_NAME=campaign_instance

# ==========================================
# 3. CAMPAIGN / TEST SETTINGS
# ==========================================
# Specify comma-separated phone numbers for testing (e.g. +919876543210, +919876543211)
# When set, the script will ONLY send to these test numbers found in Excel.
# Leave empty to send to all valid Excel recipients.
TEST_PHONE_NUMBERS=

# Safe throttle delay in seconds between sending messages (default: 2.0s)
MESSAGE_DELAY_SECONDS=2.0
